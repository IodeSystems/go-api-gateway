    "graphql-request": "^7.4.0",
    "graphql-tag": "^2.12.7",
    "graphql-ws": "^6.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.0",
